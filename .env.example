# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ragam_bahasa_db
MYSQL_USER=rana_user
MYSQL_PASSWORD=secure_password

# Backend Configuration

# Database URL (use mysql+pymysql:// for proper driver)
# Local: mysql+pymysql://username:password@localhost:3306/database_name
# Railway: Will be injected via ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql+pymysql://rbnuser:yourpassword@localhost:3306/ragam_bahasa_db

# JWT Configuration  
SECRET_KEY=change-this-to-a-random-string-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated for multiple origins)
# Local: http://localhost:5173
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173

# Application
PROJECT_NAME=Ragam Bahasa Nusantara API
VERSION=1.0.0
DEBUG=True

# Frontend Configuration
VITE_API_URL=http://localhost:8069
