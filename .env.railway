# Railway Environment Variables Template
# Copy these to your Railway project: https://railway.app/project/[your-project-id]/variables

# Backend Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-very-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=False

# Database Configuration (Auto-generated by Railway MySQL plugin)
# Don't set this if you're using Railway's MySQL plugin
# DATABASE_URL will be automatically set by Railway
# DATABASE_URL=mysql+pymysql://user:password@host:port/database

# MySQL Configuration (if using Railway MySQL plugin)
MYSQL_ROOT_PASSWORD=your-strong-root-password
MYSQL_DATABASE=ragam_bahasa_db
MYSQL_USER=rana_user
MYSQL_PASSWORD=your-strong-user-password

# Frontend Configuration (if needed)
VITE_API_URL=https://your-backend-domain.railway.app

# CORS Configuration
# Add your Railway frontend URL here
CORS_ORIGINS=["https://your-frontend.railway.app", "http://localhost:3000"]

# PORT (Railway sets this automatically, don't override)
# PORT=8069
